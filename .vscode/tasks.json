{
    "tasks": [
        {
            "label": "C/C++: gcc build active file",
            "type": "cppbuild",
            "command": "gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-lm",
                "-o",
                "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "CMake config Labor04_Aufgabe_Module",
            "type": "shell",
            "command": "cmake.exe",
            "args": [
                "-G",
                "Ninja",
                "-S",
                "${workspaceFolder}/Labor04_Aufgabe_Module",
                "-B",
                "${workspaceFolder}/build/Labor04_Aufgabe_Module"
            ]
        },
        {
            "label": "CMake build Labor04_Aufgabe_Module",
            "type": "shell",
            "command": "cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build/Labor04_Aufgabe_Module"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "CMake config Labor04_Aufgabe_Module",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}